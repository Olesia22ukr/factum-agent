# Скопіюйте цей файл у .env та заповніть значення для локального запуску.
# У продакшені (Render/Railway/Fly.io) ці ж змінні задаються
# в налаштуваннях Environment Variables на самій платформі — .env туди не завантажується.

OPENAI_API_KEY=sk-...ваш_ключ...
OPENAI_MODEL=gpt-4.1

AGENT_MAX_STEPS=20
AGENT_TIMEOUT_SECONDS=90

HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
SCRAPE_DELAY_SECONDS=0.3

MAX_HISTORY_MESSAGES=20

# Домен(и) фронтенду через кому, або "*" для будь-якого (менш безпечно)
ALLOWED_ORIGINS=*
